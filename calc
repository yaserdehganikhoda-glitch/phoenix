                    <span class="text-sm text-indigo-200">مدت زمان دقیق (ساعت و دقیقه):</span>
                    <span id="durationText" class="text-sm font-medium text-emerald-300">--</span>
                </div>

                <div id="breaksListContainer" class="hidden bg-amber-500/20 border border-amber-400/30 p-3 rounded-xl text-xs text-amber-200">
                    <span class="font-bold">استراحت‌های بین راه در این بازه:</span>
                    <span id="breaksListText" class="mr-1">--</span>
                </div>
            </div>
        </div>

        <!-- Message Box Modal -->
        <div id="messageModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
            <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center">
                <div class="text-3xl mb-3">⚠️</div>
                <h3 id="modalTitle" class="text-lg font-bold text-gray-800 mb-2">خطا در ورودی</h3>
                <p id="modalMessage" class="text-sm text-gray-600 mb-5">لطفاً مقادیر معتبر وارد کنید.</p>
                <button onclick="closeModal()" class="w-full py-2.5 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition">متوجه شدم</button>
            </div>
        </div>

    </div>

    <script>
        function showMessage(title, message) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            document.getElementById('messageModal').classList.remove('hidden');
            document.getElementById('messageModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('messageModal').classList.remove('flex');
            document.getElementById('messageModal').classList.add('hidden');
        }

        function calculateFinishTime() {
            const startTimeInput = document.getElementById('startTime').value;
            const maxCapacity = parseFloat(document.getElementById('maxCapacity').value);
            const userQuantity = parseFloat(document.getElementById('userQuantity').value);

            if (!startTimeInput) {
                showMessage('خطا', 'لطفاً ساعت شروع کار را وارد کنید.');
                return;
            }

            if (isNaN(maxCapacity) || maxCapacity <= 0) {
                showMessage('خطا', 'حداکثر تعداد کار باید یک عدد بزرگتر از صفر باشد.');
                return;
            }

            if (isNaN(userQuantity) || userQuantity < 0) {
                showMessage('خطا', 'تعداد لباس دریافتی نامعتبر است.');
                return;
            }

            // تایم کاری کل بر حسب دقیقه (۸ ساعت و یک ربع = ۴۹۵ دقیقه)
            const totalShiftMinutes = (8 * 60) + 15;

            // محاسبه زمان لازم بر اساس فرمول تناسب درخواستی: (تعداد دریافتی * زمان کل شیفت) / حداکثر ظرفیت
            const totalMinutesNeeded = (userQuantity * totalShiftMinutes) / maxCapacity;
            const totalHoursNeeded = totalMinutesNeeded / 60;

            // Parse start time
            const [startHours, startMinutes] = startTimeInput.split(':').map(Number);
            const startTotalMinutes = (startHours * 60) + startMinutes;

            // Define breaks
            const breaks = [
                { name: 'صبحانه (09:00-09:30)', start: 9 * 60, end: 9 * 60 + 30 },
                { name: 'چای اول (11:45-12:00)', start: 11 * 60 + 45, end: 12 * 60 },
                { name: 'ناهار (13:45-14:30)', start: 13 * 60 + 45, end: 14 * 60 + 30 },
                { name: 'چای دوم (16:15-16:30)', start: 16 * 60 + 15, end: 16 * 60 + 30 }
            ];

            // Simulate minutes passing, skipping break periods
            let currentMinutes = startTotalMinutes;
            let remainingWorkMinutes = totalMinutesNeeded;
            let activeBreaksEncountered = [];
            let safety = 0;

            while (remainingWorkMinutes > 0 && safety < 2880) {
                // Check if current clock time is inside any break
                let activeBreak = breaks.find(b => currentMinutes >= b.start && currentMinutes < b.end);
                if (activeBreak) {
                    if (!activeBreaksEncountered.includes(activeBreak.name)) {
                        activeBreaksEncountered.push(activeBreak.name);
                    }
                    currentMinutes = activeBreak.end; // Skip past the break
                } else {
                    // Active work minute
                    let step = Math.min(1, remainingWorkMinutes);
                    remainingWorkMinutes -= step;
                    currentMinutes += 1;
                }
                safety++;
            }

            // Convert back to finish clock hours and minutes
            const finishHours = Math.floor(currentMinutes / 60) % 24;
            const finishMins = Math.round(currentMinutes % 60);
            const formattedFinishTime = `${String(finishHours).padStart(2, '0')}:${String(finishMins).padStart(2, '0')}`;

            // Format hours needed
            const hoursDecimalStr = totalHoursNeeded.toFixed(2) + ' ساعت';

            // Format readable duration (hours and minutes)
            const hoursNeeded = Math.floor(totalHoursNeeded);
            const minsNeeded = Math.round((totalHoursNeeded - hoursNeeded) * 60);
            let durationStr = '';
            if (hoursNeeded > 0) {
                durationStr += `${hoursNeeded} ساعت `;
            }
            if (minsNeeded > 0 || hoursNeeded === 0) {
                durationStr += `${minsNeeded} دقیقه`;
            }

            // Display results
            document.getElementById('finishTimeText').innerText = formattedFinishTime;
            document.getElementById('durationHoursText').innerText = hoursDecimalStr;
            document.getElementById('durationText').innerText = durationStr;

            // Display breaks summary
            const breaksListContainer = document.getElementById('breaksListContainer');
            const breaksListText = document.getElementById('breaksListText');
            if (activeBreaksEncountered.length > 0) {
                breaksListContainer.classList.remove('hidden');
                breaksListText.innerText = activeBreaksEncountered.join('، ');
            } else {
                breaksListContainer.classList.add('hidden');
            }

            const resultCard = document.getElementById('resultCard');
            resultCard.classList.remove('hidden');
            resultCard.scrollIntoView({ behavior: 'smooth' });
        }

        // Auto calculate on load with defaults
        window.onload = function() {
            calculateFinishTime();
        };
    </script>
</body>
</html>
