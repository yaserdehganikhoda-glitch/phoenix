            <button onclick="calculateFinishTime()" 
                class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold rounded-xl shadow-lg hover:from-indigo-700 hover:to-purple-700 transition transform active:scale-95 text-lg mt-2">
