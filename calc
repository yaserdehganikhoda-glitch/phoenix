    <style>
        body {
            font-family: 'Vazirmatn', sans-serif;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 min-h-screen flex items-center justify-center p-4">

    <div class="bg-white/90 backdrop-blur-md shadow-2xl rounded-3xl p-6 sm:p-8 w-full max-w-xl border border-white/20">
        
        <!-- Header -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-tr from-indigo-500 to-purple-600 text-white rounded-2xl shadow-lg mb-3 text-3xl">
                🧵
            </div>
            <h1 class="text-2xl font-bold text-gray-800">ماشین‌حساب زمان خیاطی هوشمند</h1>
            <p class="text-sm text-gray-500 mt-1">محاسبه ساعت اتمام کار (شیفت ۸ ساعت و ۱۵ دقیقه + استراحت‌های مصوب)</p>
        </div>

        <!-- Break Times Info Box -->
        <div class="mb-6 bg-amber-50 border border-amber-200/60 rounded-2xl p-4 text-xs text-amber-800">
            <div class="font-bold mb-2 flex items-center gap-1.5 text-amber-900 text-sm">
                <span>☕</span> برنامه‌ی استراحت‌های رسمی شیفت:
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
                <div class="bg-white/80 p-2 rounded-xl shadow-xs">
                    <span class="block font-semibold">صبحانه</span>
                    <span class="text-amber-700">۰۹:۰۰ - ۰۹:۳۰</span>
                </div>
                <div class="bg-white/80 p-2 rounded-xl shadow-xs">
                    <span class="block font-semibold">چای اول</span>
                    <span class="text-amber-700">۱۱:۴۵ - ۱۲:۰۰</span>
                </div>
                <div class="bg-white/80 p-2 rounded-xl shadow-xs">
                    <span class="block font-semibold">ناهار</span>
                    <span class="text-amber-700">۱۳:۴۵ - ۱۴:۳۰</span>
                </div>
                <div class="bg-white/80 p-2 rounded-xl shadow-xs">
                    <span class="block font-semibold">چای دوم</span>
                    <span class="text-amber-700">۱۶:۱۵ - ۱۶:۳۰</span>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <!-- Start Time -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">ساعت شروع کار:</label>
                <input type="time" id="startTime" value="08:00" 
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition text-lg bg-gray-50">
            </div>

            <!-- Max Capacity per Shift -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">حداکثر تعداد کار در کل شیفت (۸ ساعت و ۱۵ دقیقه کار مفید):</label>
                <input type="number" id="maxCapacity" value="50" min="1" placeholder="مثلاً ۵۰ لباس"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition text-lg bg-gray-50">
            </div>

            <!-- User Assigned Quantity -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">تعداد لباس دریافتی شما برای دوخت:</label>
                <input type="number" id="userQuantity" value="20" min="1" placeholder="مثلاً ۲۰ لباس"
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-indigo-500 focus:border-transparent outline-none transition text-lg bg-gray-50">
            </div>

